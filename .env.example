# Server only. Copy this file to .env at the repository root.
# Supabase Connect → Transaction pooler (runtime API connection).
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require"
# Supabase Connect → Session pooler (IPv4) or Direct connection (IPv6).
# Prisma migrations and seed use this connection; do not use port 6543 here.
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="barbershop"

APP_URL="http://localhost:3000"
MINIAPP_URL="http://localhost:5173,http://127.0.0.1:5173"
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
VITE_API_URL="http://localhost:3001/api/v1"
VITE_WEB_URL="http://localhost:3000"
VITE_BASE_PATH="/miniapp/"
API_HOST="127.0.0.1"
API_PORT="3001"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="bravo_barber_bot"
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET="change-this-to-a-long-random-secret"
API_PUBLIC_URL="https://your-api.example.com"
MINIAPP_PUBLIC_URL="https://your-api.example.com/miniapp/"
CRON_SECRET="generate-a-long-random-secret"
# Used only by Supabase CLI for deploying Edge Functions; never expose to browser code.
SUPABASE_ACCESS_TOKEN=""
ADMIN_SESSION_SECRET="generate-at-least-32-random-characters"
