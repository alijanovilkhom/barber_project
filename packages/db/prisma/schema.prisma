generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  confirmed
  completed
  cancelled
  no_show
}

enum BookingSource {
  web
  telegram
  admin
}

enum TimeOffType {
  day_off
  vacation
  sick_leave
  other
}

model Barber {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String          @unique
  name            String
  photoUrl        String?         @map("photo_url")
  bio             String?
  experienceYears Int             @default(0) @map("experience_years")
  telegramChatId  BigInt?         @map("telegram_chat_id")
  isActive        Boolean         @default(true) @map("is_active")
  sortOrder       Int             @default(0) @map("sort_order")
  portfolio       PortfolioItem[]
  services        BarberService[]
  workingHours    WorkingHours[]
  breaks          Break[]
  timeOff         TimeOff[]
  bookings        Booking[]
  reviews         Review[]

  @@map("barbers")
}

model PortfolioItem {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId  String @map("barber_id") @db.Uuid
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order")
  barber    Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, sortOrder])
  @@map("portfolio_items")
}

model Service {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String           @unique
  name        String
  description String?
  durationMin Int              @map("duration_min")
  price       Decimal          @db.Decimal(12, 2)
  isActive    Boolean          @default(true) @map("is_active")
  sortOrder   Int              @default(0) @map("sort_order")
  barbers     BarberService[]
  bookings    BookingService[]

  @@map("services")
}

model BarberService {
  barberId    String   @map("barber_id") @db.Uuid
  serviceId   String   @map("service_id") @db.Uuid
  durationMin Int?     @map("duration_min")
  price       Decimal? @db.Decimal(12, 2)
  isEnabled   Boolean  @default(true) @map("is_enabled")
  barber      Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([serviceId])
  @@map("barber_services")
}

// Local wall time in settings.timezone. Weekday: 0 = Sunday, 6 = Saturday.
model WorkingHours {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  weekday   Int      @db.SmallInt
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday])
  @@map("working_hours")
}

model Break {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  weekday   Int      @db.SmallInt
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday, startTime])
  @@map("breaks")
}

model TimeOff {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId String?     @map("barber_id") @db.Uuid
  startsAt DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime    @map("ends_at") @db.Timestamptz(3)
  type     TimeOffType @default(other)
  note     String?
  barber   Barber?     @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startsAt, endsAt])
  @@map("time_off")
}

model Client {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  phone          String    @unique
  telegramId     BigInt?   @unique @map("telegram_id")
  telegramChatId BigInt?   @map("telegram_chat_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  bookings       Booking[]
  reviews        Review[]

  @@map("clients")
}

model Booking {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId             String           @map("client_id") @db.Uuid
  barberId             String           @map("barber_id") @db.Uuid
  startsAt             DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime         @map("ends_at") @db.Timestamptz(3)
  totalPrice           Decimal          @map("total_price") @db.Decimal(12, 2)
  totalDurationMin     Int              @map("total_duration_min")
  status               BookingStatus    @default(confirmed)
  source               BookingSource    @default(web)
  manageToken          String           @unique @default(uuid()) @map("manage_token")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  reminderDaySentAt    DateTime?        @map("reminder_day_sent_at") @db.Timestamptz(3)
  reminder30mSentAt    DateTime?        @map("reminder_30m_sent_at") @db.Timestamptz(3)
  reviewRequestedAt   DateTime?        @map("review_requested_at") @db.Timestamptz(3)
  autoCompletedAt     DateTime?        @map("auto_completed_at") @db.Timestamptz(3)
  timeRange            Unsupported("tstzrange")? @map("time_range")
  client               Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  barber               Barber           @relation(fields: [barberId], references: [id], onDelete: Restrict)
  services             BookingService[]
  review               Review?

  @@index([barberId, startsAt, endsAt])
  @@index([clientId, startsAt])
  @@index([status, startsAt])
  @@map("bookings")
}

model BookingService {
  bookingId   String  @map("booking_id") @db.Uuid
  serviceId   String  @map("service_id") @db.Uuid
  name        String
  durationMin Int     @map("duration_min")
  price       Decimal @db.Decimal(12, 2)
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([bookingId, serviceId])
  @@index([serviceId])
  @@map("booking_services")
}

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  rating    Int      @db.SmallInt
  comment   String?
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Restrict)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([barberId, isPublic, createdAt])
  @@index([clientId])
  @@map("reviews")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}

model AdminUser {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  login          String @unique
  passwordHash   String @map("password_hash")
  telegramChatId BigInt? @map("telegram_chat_id")

  @@map("admin_users")
}
